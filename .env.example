# Frontend
# Local development. The production web build in apps/web/.env.production uses /api
# so the deployed site calls the API on its own host.
VITE_API_URL=http://localhost:5000/api

# API
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/edusync
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Browser origins allowed in every environment. Development also allows any http://localhost port,
# including the Electron window when port 5173 is already taken.
CLIENT_ORIGINS=http://localhost:5173
APP_URL=http://localhost:5173
COOKIE_SECURE=false

# Optional SMTP (required in production for invitations and password resets)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=EduSync <no-reply@example.com>

# One-time super administrator seed command
SUPER_ADMIN_NAME=EduSync Platform Admin
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
